# Ansible artifacts
*.retry
*.pyc
__pycache__/
logs/
tmp/

# Domain-specific configuration (gitignored for security)
# *.example files are tracked as public templates
inventory/group_vars/*
!inventory/group_vars/*.example

# Site-specific host inventories (gitignored — use *.example.yml as templates)
inventory/*.yml
!inventory/localhost.yml
!inventory/*.yml.example

# Python virtual environments (if testing locally)
venv/
*.egg-info/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS artifacts
.DS_Store
Thumbs.db
