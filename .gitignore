# Ansible artifacts
*.retry
*.pyc
__pycache__/
logs/
tmp/

# Private inventory — use inventory/hosts/ as a nested private git repo
# Public templates: inventory/*.yml.example and inventory/group_vars/all.yml.example
inventory/hosts/

# Legacy gitignores — kept for any files still in inventory/ root
inventory/group_vars/*
!inventory/group_vars/*.example
inventory/*.yml
!inventory/localhost.yml
!inventory/*.yml.example

# Python virtual environments (if testing locally)
venv/
*.egg-info/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS artifacts
.DS_Store
Thumbs.db
