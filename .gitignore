# Ansible artifacts
*.retry
*.pyc
__pycache__/
logs/
tmp/

# Private inventory — nested private git repo (*-inventory on Gitea + GitHub)
# Real group_vars live in inventory/hosts/group_vars/
# inventory/group_vars/ and inventory root hold only *.example public templates
inventory/hosts
inventory/group_vars/*
!inventory/group_vars/*.example
inventory/*.yml
!inventory/localhost.yml
!inventory/*.yml.example

# Python virtual environments (if testing locally)
venv/
*.egg-info/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS artifacts
.DS_Store
Thumbs.db

# Developer architecture notes — stay local, not shipped
CLAUDE.md
