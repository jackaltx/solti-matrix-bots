[Unit]
Description=Matrix Bot - {{ bot_properties.root }}
After=network-online.target
Wants=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=simple
WorkingDirectory={{ bot_properties.working_dir }}

{% if bot_properties.pre_start_check is defined %}
# Wait for required service before starting
ExecStartPre=/bin/bash -c '{{ bot_properties.pre_start_check }}'
{% endif %}
# Execute bot from shared venv
ExecStart={{ bot_properties.venv_dir }}/bin/python -u {{ bot_properties.bot_dir }}/{{ bot_properties.script_name }}

# Environment variables from bot_properties
{% for key, value in bot_properties.environment.items() %}
Environment="{{ key }}={{ value }}"
{% endfor %}

{% if bot_properties.vault_approle | default(false) %}
# Vault AppRole — bot authenticates at startup to fetch all secrets from Vault at runtime
Environment="VAULT_ADDR={{ vault_addr }}"
Environment="VAULT_ROLE_ID_FILE={{ real_user_dir }}/.vault-approle/{{ bot_properties.root }}-role-id"
Environment="VAULT_SECRET_ID_FILE={{ real_user_dir }}/.vault-approle/{{ bot_properties.root }}-secret-id"
{% if bot_properties.vault_bot_host is defined %}
Environment="VAULT_BOT_HOST={{ bot_properties.vault_bot_host }}"
{% endif %}
{% if bot_properties.vault_matrix_host is defined %}
Environment="VAULT_MATRIX_HOST={{ bot_properties.vault_matrix_host }}"
{% endif %}
{% else %}
# Secrets (values resolved from environment at deploy time)
{% for secret_name in bot_properties.secrets %}
Environment="{{ secret_name }}={{ lookup('env', secret_name) }}"
{% endfor %}
{% endif %}

# Restart policy
Restart={{ bot_properties.restart_policy }}
RestartSec={{ bot_properties.restart_sec | default(30) }}

# Logging (journald)
StandardOutput=journal
StandardError=journal
SyslogIdentifier={{ bot_properties.root }}

[Install]
WantedBy=default.target
